{
  "info": {
    "name": "Matrícula API",
    "description": "Colección de pruebas funcionales para la API de Matrícula (v1). Cubre los requerimientos RF-01 a RF-07 y las reglas de negocio RN-01 a RN-04. Ejecutar en orden dentro de cada carpeta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "carreraId", "value": "1" },
    { "key": "cursoId", "value": "" },
    { "key": "estudianteId", "value": "" },
    { "key": "matriculaId", "value": "" }
  ],
  "item": [
    {
      "name": "RF-01 Salud y contrato",
      "item": [
        {
          "name": "GET /health devuelve 200 y database UP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('tiene status, database y timestamp', () => {",
                  "  pm.expect(body).to.have.property('status');",
                  "  pm.expect(body).to.have.property('database');",
                  "  pm.expect(body).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v3/api-docs expone título Matrícula API y versión v1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/api-docs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('titulo y version correctos', () => {",
                  "  pm.expect(body.info.title).to.eql('Matrícula API');",
                  "  pm.expect(body.info.version).to.eql('v1');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /swagger-ui.html responde 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/swagger-ui.html"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
