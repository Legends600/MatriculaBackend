  "item": [
    {
      "name": "00 Resolver IDs (ejecutar primero, siempre)",
      "item": [
        {
          "name": "CP-00a Resolver IDs de carreras",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/carreras"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const porNombre = n => body.find(c => c.nombre === n);",
                  "pm.collectionVariables.set('carreraSistemasId', porNombre('Ingeniería de Sistemas').id);",
                  "pm.collectionVariables.set('carreraCivilId', porNombre('Ingeniería Civil').id);",
                  "pm.collectionVariables.set('carreraArquitecturaId', porNombre('Arquitectura').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-00b Resolver IDs de estudiantes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/estudiantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const porCodigo = c => body.find(e => e.codigo === c);",
                  "pm.collectionVariables.set('anaId', porCodigo('202410001').id);",
                  "pm.collectionVariables.set('jorgeId', porCodigo('202410002').id);",
                  "pm.collectionVariables.set('mariaId', porCodigo('202410003').id);",
                  "pm.collectionVariables.set('carlosId', porCodigo('202410004').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CP-00c Resolver IDs de cursos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const porCodigo = c => body.find(x => x.codigo === c);",
                  "['IS401','IS402','IS403','IS404','IS501','IS502','IS503','IC401'].forEach(c => {",
                  "  pm.collectionVariables.set(c + 'Id', porCodigo(c).id);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
